<!-- Updated boilerplate.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
    <link rel="stylesheet" href="/css/style.css">
    <link 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" 
        rel="stylesheet" 
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" 
        crossorigin="anonymous"
    />
    <link 
        rel="stylesheet" 
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" 
        integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" 
        crossorigin="anonymous" 
        referrerpolicy="no-referrer" 
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/rating.css" />
</head>
<body>
    <%- include("../includes/navbar.ejs") %>

    <div class="container">
        <%- include("../includes/flash.ejs") %>
        <%- body %>
    </div>

    <%- include("../includes/footer.ejs") %>

    <script>
        let listingData = null; // will be set in page-specific EJS

        function initMap() {
            // Default location if no listing data is present (India center)
            const defaultCoords = { lat: 20.5937, lng: 78.9629 };

            const coords = listingData && listingData.geometry
                ? {
                    lat: listingData.geometry.coordinates[1],
                    lng: listingData.geometry.coordinates[0]
                }
                : defaultCoords;

            const map = new google.maps.Map(document.getElementById("map"), {
                center: coords,
                zoom: listingData ? 12 : 4,
                mapId: "WANDERLUST_MAP"
            });

            if (listingData && listingData.geometry) {
                new google.maps.marker.AdvancedMarkerElement({
                    position: coords,
                    map: map,
                    title: listingData.title || "Listing Location"
                });
            }
        }
    </script>

    <!-- Load Google Maps API once -->
    <script
        src="https://maps.googleapis.com/maps/api/js?key=<%=process.env.GOOGLE_MAPS_API_KEY%>&libraries=marker,places&callback=initMap"
        async
        defer>
    </script>
</body>
</html>